## PrivWatch 3.0 - Linux Audit Telemetry Configuration Rules (auditd)
## Install to /etc/audit/rules.d/privwatch.rules and run `augenrules --load` or `service auditd restart`
## Reference: https://github.com/gokullaxman/privwatch

## 1. Delete all existing rules and set buffer size
-D
-b 8192
-f 1

## 2. Monitor Process Execution & Privilege Transitions (64-bit Architecture)
-a always,exit -F arch=b64 -S execve,execveat -k privwatch_exec
-a always,exit -F arch=b64 -S setuid,setreuid,setresuid -k privwatch_setuid
-a always,exit -F arch=b64 -S setgid,setregid,setresgid -k privwatch_setgid
-a always,exit -F arch=b64 -S capset -k privwatch_capabilities

## 3. Monitor Process Execution & Privilege Transitions (32-bit Architecture compatibility)
-a always,exit -F arch=b32 -S execve,execveat -k privwatch_exec
-a always,exit -F arch=b32 -S setuid,setreuid,setresuid -k privwatch_setuid
-a always,exit -F arch=b32 -S setgid,setregid,setresgid -k privwatch_setgid
-a always,exit -F arch=b32 -S capset -k privwatch_capabilities

## 4. Monitor Sensitive Authentication & Credential Databases
-w /etc/passwd -p wa -k privwatch_passwd_changes
-w /etc/shadow -p rwa -k privwatch_shadow_access
-w /etc/gshadow -p rwa -k privwatch_shadow_access
-w /etc/security/ -p wa -k privwatch_pam_changes

## 5. Monitor Sudoers Configuration
-w /etc/sudoers -p wa -k privwatch_sudoers_changes
-w /etc/sudoers.d/ -p wa -k privwatch_sudoers_changes

## 6. Monitor Scheduled Tasks (Cron & Systemd Timers)
-w /etc/crontab -p wa -k privwatch_cron_changes
-w /etc/cron.d/ -p wa -k privwatch_cron_changes
-w /etc/cron.daily/ -p wa -k privwatch_cron_changes
-w /etc/cron.hourly/ -p wa -k privwatch_cron_changes
-w /etc/cron.weekly/ -p wa -k privwatch_cron_changes
-w /etc/cron.monthly/ -p wa -k privwatch_cron_changes
-w /var/spool/cron/ -p wa -k privwatch_cron_changes
-w /etc/systemd/system/ -p wa -k privwatch_systemd_changes

## 7. Monitor Kernel Modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k privwatch_kernel_modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k privwatch_kernel_modules

## 8. Lock Audit Configuration (Requires reboot to modify after enabling)
## Uncomment the following line for high-security hardened environments:
## -e 2
